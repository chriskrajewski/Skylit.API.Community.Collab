{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"pckt-bench signals","type":"object",
 "required":["schema","slice","window","signals"],
 "properties":{"schema":{"const":1},"slice":{"type":"string"},
  "labeling":{"type":"object"},
  "window":{"type":"object","required":["lead_min","close_after_min"],"properties":{"lead_min":{"type":"integer"},"close_after_min":{"type":"integer"},"session":{"type":"string"}}},
  "signals":{"type":"array","items":{"type":"object","required":["id","date","direction","start","end","legs"],
   "properties":{"id":{"type":"string"},"date":{"type":"string","pattern":"^\d{4}-\d{2}-\d{2}$"},"direction":{"enum":["long","short"]},
    "start":{"type":"integer","description":"UTC epoch seconds: earliest leg t0"},"end":{"type":"integer","description":"UTC epoch seconds: latest leg t1"},
    "start_et":{"type":"string"},"end_et":{"type":"string"},
    "legs":{"type":"object","propertyNames":{"enum":["SPX","SPY","QQQ"]},"additionalProperties":{"type":"object","required":["t0","p0","t1","p1"],
      "properties":{"t0":{"type":"integer"},"p0":{"type":"number"},"t1":{"type":"integer"},"p1":{"type":"number"}}}}}}}}}

# Copy this file to .env and set the values on your machine.
# Commit this example with every value empty. Do not commit .env or a real key.
# A non-blank shell variable takes precedence over the .env value.
SKYLIT_API_KEY=
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PRACTICE_ACCOUNT_ID=
COMBINE_ACCOUNT_ID=
NOTIFIER_WEBHOOK_URL=
NARRATOR_API_KEY=
FSE_SECRET_VARS=
# fse run sends a plugin's ProjectX orders only when this is enabled AND the start
# command has --plugin-orders. The AWS runner service's fixed start command never has
# that flag, so setting this variable has no effect on the AWS runner service.
# FSE_RUN_PLUGIN_ORDERS=
